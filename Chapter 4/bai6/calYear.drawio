        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    Start([Bắt đầu chương trình]) --&gt; Main[Hàm main]\n    Main --&gt; PrintTitle[In tiêu đề: HAY NHAP THANG VA NAM CUA BAN]\n    PrintTitle --&gt; InputMonth[Nhập tháng]\n    InputMonth --&gt; InputYear[Nhập năm]\n    \n    InputYear --&gt; CallGetYear[Gọi hàm getYear year]\n    CallGetYear --&gt; CallGetMonth[Gọi hàm getMonth month, nhuan]\n    CallGetMonth --&gt; PrintResult[In kết quả: Tháng... năm... có... ngày]\n    PrintResult --&gt; End([Kết thúc])\n\n    %% Hàm getYear\n    subgraph Ham_getYear [Hàm getYear year]\n        GY_Start([Bắt đầu getYear]) --&gt; GY_Check{year % 4 == 0 AND year % 100 != 0&lt;br&gt;OR year % 400 == 0?}\n        GY_Check -- Đúng --&gt; GY_Ret1[return 1: Năm nhuận]\n        GY_Check -- Sai --&gt; GY_Ret0[return 0: Không nhuận]\n        GY_Ret1 --&gt; GY_End([Kết thúc getYear])\n        GY_Ret0 --&gt; GY_End\n    end\n\n    %% Hàm getMonth\n    subgraph Ham_getMonth [Hàm getMonth month, nhuan]\n        GM_Start([Bắt đầu getMonth]) --&gt; GM_Check1{month == 1, 3, 5, 7, 8, 10, 12?}\n        GM_Check1 -- Đúng --&gt; GM_Ret31[return 31]\n        GM_Check1 -- Sai --&gt; GM_Check2{month == 4, 6, 9, 11?}\n        GM_Check2 -- Đúng --&gt; GM_Ret30[return 30]\n        GM_Check2 -- Sai --&gt; GM_Check3{month == 2?}\n        GM_Check3 -- Đúng --&gt; GM_CheckNhuan{nhuan == 1?}\n        GM_CheckNhuan -- Đúng --&gt; GM_Ret29[return 29]\n        GM_CheckNhuan -- Sai --&gt; GM_Ret28[return 28]\n        \n        GM_Ret31 --&gt; GM_End([Kết thúc getMonth])\n        GM_Ret30 --&gt; GM_End\n        GM_Ret29 --&gt; GM_End\n        GM_Ret28 --&gt; GM_End\n        GM_Check3 -- Sai --&gt; GM_End\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="na7JiT4yiViDq2_fmNCP-1">
