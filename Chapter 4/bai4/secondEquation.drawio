        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    Start([Bắt đầu]) --&gt; PrintTitle[In tiêu đề: GIAI PT BAC HAI]\n    PrintTitle --&gt; InputA[Nhập hệ số a]\n    InputA --&gt; InputB[Nhập hệ số b]\n    InputB --&gt; InputC[Nhập hệ số c]\n    \n    InputC --&gt; CheckA{a == 0?}\n    \n    %% Trường hợp a == 0 (Giải PT bậc 1: bx + c = 0)\n    CheckA -- Đúng --&gt; CheckB{b == 0?}\n    CheckB -- Đúng --&gt; CheckC{c == 0?}\n    CheckC -- Đúng --&gt; PrintVSN[In: Phương trình có vô số nghiệm]\n    CheckC -- Sai --&gt; PrintVN1[In: Phương trình vô nghiệm]\n    \n    CheckB -- Sai --&gt; PrintPT1[In: x = -c / b]\n    \n    %% Trường hợp a != 0 (Giải PT bậc 2)\n    CheckA -- Sai --&gt; CalcDelta[delta = b^2 - 4 * a * c]\n    CalcDelta --&gt; CheckDelta{delta &lt; 0?}\n    \n    CheckDelta -- Đúng --&gt; PrintVN2[In: Phương trình vô nghiệm]\n    CheckDelta -- Sai --&gt; CheckDeltaZero{delta == 0?}\n    \n    CheckDeltaZero -- Đúng --&gt; CalcNK[x1 = x2 = -b / 2 * a]\n    CalcNK --&gt; PrintNK[In nghiệm kép x1 = x2]\n    \n    CheckDeltaZero -- Sai --&gt; Calc2N[x1 = -b + sqrt delta / 2 * a&lt;br&gt;x2 = -b - sqrt delta / 2 * a]\n    Calc2N --&gt; Print2N[In 2 nghiệm phân biệt x1, x2]\n    \n    %% Kết thúc\n    PrintVSN --&gt; End([Kết thúc])\n    PrintVN1 --&gt; End\n    PrintPT1 --&gt; End\n    PrintVN2 --&gt; End\n    PrintNK --&gt; End\n    Print2N --&gt; End&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Y3D4xysATeLNXpWmuJy--1">
